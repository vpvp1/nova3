{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova3",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "59263871-bfd5-4a98-b0c1-c9edf23c3770","database_name": "nova3" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9c573bc66f4244c69ccb819858f5fb31" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
